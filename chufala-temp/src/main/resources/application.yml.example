# =====================================================================
# 配置模板：请复制为 application.yml 后填入真实值
#   cp application.yml.example application.yml
#
# 真实 application.yml 已被 .gitignore 排除，不会进入版本库。
# 所有敏感项均通过环境变量注入，切勿把真实值写回本文件。
# =====================================================================

server:
  port: 9010

spring:
  mvc:
    async:
      request-timeout: 240000 # 全局异步请求超时（毫秒，0 表示永不超时）

  ai:
    dashscope:
      api-key: ${AI_DASHSCOPE_API_KEY}
      embedding:
        options:
          model: "text-embedding-v4"
          text-type: "document"
          dimensions: 1536

    zhipuai:
      api-key: ${ZHIPU_API_KEY}
      chat:
        options:
          model: glm-4.5-flash
          temperature: 0.8
      embedding:
        options:
          model: text-embedding-large

    openai:
      api-key: ${DEEPSEEK_API_KEY}
      chat:
        base-url: "https://api.deepseek.com/"
        options:
          model: "deepseek-chat"

    ollama:
      base-url: "http://localhost:11434"
      chat:
        model: "qwen3:0.6b"

    mcp:
      client:
        enabled: true
        name: amap-client
        version: 1.0.0
        type: ASYNC
        request-timeout: 60s

    vectorstore:
      milvus:
        client:
          host: localhost
          port: 19530
        databaseName: "default"      # 默认数据库名称
        collectionName: "vector_store" # 默认集合名称
        embeddingDimension: 1536
        indexType: IVF_FLAT
        metricType: COSINE

  datasource:
    type: com.alibaba.druid.pool.DruidDataSource
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://localhost:3306/chufala_db?serverTimezone=Asia/Shanghai&useUnicode=true&characterEncoding=utf-8&allowMultiQueries=true
    username: ${MYSQL_USERNAME}
    password: ${MYSQL_PASSWORD}

    # Druid 连接池
    druid:
      initial-size: 5
      min-idle: 5
      max-active: 20
      # 监控页面
      stat-view-servlet:
        enabled: true
        url-pattern: /druid/*
        login-username: ${DRUID_USERNAME}
        login-password: ${DRUID_PASSWORD}
        reset-enable: false
      web-stat-filter:
        enabled: true
        url-pattern: /*
        exclusions: "*.js,*.gif,*.jpg,*.png,*.css,*.ico,/druid/*"
      filters: stat,wall,slf4j
      filter:
        stat:
          log-slow-sql: true
          slow-sql-millis: 2000

  rabbitmq:
    host: 127.0.0.1
    port: 5672
    username: ${RABBITMQ_USERNAME}
    password: ${RABBITMQ_PASSWORD}
    virtual-host: /chufala

mybatis-plus:
  configuration:
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl

# 支付宝（沙箱）
alipay:
  appId: ${ALIPAY_APP_ID}
  merchantPrivateKey: ${ALIPAY_MERCHANT_PRIVATE_KEY}
  alipayPublicKey: ${ALIPAY_PUBLIC_KEY}
  notifyUrl: ${ALIPAY_NOTIFY_URL}
  returnUrl: ${ALIPAY_RETURN_URL}
  signType: RSA2
  charset: utf-8
  gatewayUrl: https://openapi-sandbox.dl.alipaydev.com/gateway.do

# 阿里云 OSS
aliyun:
  oss:
    endpoint: https://oss-cn-shenzhen.aliyuncs.com
    accessKeyId: ${ALIYUN_OSS_ACCESS_KEY_ID}
    accessKeySecret: ${ALIYUN_OSS_ACCESS_KEY_SECRET}
    bucketName: chufala

# 大模型
llm:
  api-key: ${DOUBAO_API_KEY}
  url: "https://ark.cn-beijing.volces.com/api"
  model: "doubao-seed-1-6-flash-250828"

deepseek:
  api-key: ${DEEPSEEK_API_KEY}
  url: "https://api.deepseek.com/"
  model: "deepseek-chat"

logging:
  level:
    root: INFO
    org.springframework.ai: DEBUG
