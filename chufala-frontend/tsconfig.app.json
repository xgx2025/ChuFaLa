{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    // allowJs：本项目绝大多数 .vue 用的是**不带 lang="ts"** 的 <script setup>（纯 JS）。
    // vue-tsc 会把这类 SFC 映射成 JS 虚拟模块，而 allowJs 默认为 false 时，
    // 任何 .ts 文件 import 它们都会报：
    //   TS7016: Could not find a declaration file for module '@/views/Home.vue'
    // 打开 allowJs 后 TS 直接读这些 JS 模块并推断类型，一次性解决全部 22 个报错，
    // 而且**不需要**给 .vue 加 `declare module '*.vue'` 通配声明 ——
    // 那条通配声明会遮住 Icon.vue 的 30 个具名导出，反而引出 TS2614。
    // 这里只开 allowJs、不开 checkJs：JS 文件只参与类型推断，不被错误检查。
    "allowJs": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
