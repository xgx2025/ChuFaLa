# 环境变量模板
# 使用方式：复制为 .env.development 后填入真实 Key
# 真实的 .env.development 已被 .gitignore 排除，请勿提交到版本库
# 注意：客户端使用的变量必须加 VITE_ 前缀，否则不会注入到前端代码中

# 百度地图 AK
VITE_BAIDU_MAP_AK=your_baidu_map_ak

# 高德地图 Web端 api-key
VITE_AMAP_API_KEY=your_amap_web_api_key

# 高德地图 Web服务 api-key
VITE_AMAP_SERVICE_KEY=your_amap_web_service_key

# 高德地图 安全密钥
VITE_AMAP_SECURITY_CODE=your_amap_security_code
