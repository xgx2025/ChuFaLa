<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hope.chufala.mapper.HotelReviewMapper">

    <!-- 插入评论 -->
    <insert id="insertComment" parameterType="com.hope.chufala.domain.entity.HotelReview">
        INSERT INTO hotel_comment (
            hotel_id,
            score,
            user_id,
            content,
            create_time
        ) VALUES (
                     #{hotelId},
                     #{score},
                     #{userId},
                     #{content},
                     NOW()
                 )
    </insert>

    <!-- 计算酒店的平均评分和评论数
         ⚠️ 原来查的是**不存在的表** hotel_comment、以及不存在的列 score。
         评价数据实际落在 hotel_review，评分列是 rating。
         本语句由 HotelServiceImpl.submitReview 调用（评价接口目前被注释掉、无外部入口）。 -->
    <select id="calculateScoreAndCount" parameterType="java.lang.Long" resultType="java.util.Map">
        SELECT
            AVG(rating) AS new_avg,
            COUNT(*) AS new_count
        FROM hotel_review
        WHERE hotel_id = #{hotelId}
    </select>

</mapper>
