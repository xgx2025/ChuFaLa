# =====================================================================
# 配置模板：请复制为 application.yml 后填入真实值
#   cp application.yml.example application.yml
# 真实 application.yml 已被 .gitignore 排除，不会进入版本库。
# =====================================================================

aliyun:
  oss:
    endpoint: https://oss-cn-shenzhen.aliyuncs.com
    accessKeyId: ${ALIYUN_OSS_ACCESS_KEY_ID}
    accessKeySecret: ${ALIYUN_OSS_ACCESS_KEY_SECRET}
    bucketName: chufala

# 邮箱（注册验证码 + 订单通知）
email:
  smtp:
    host: smtp.qq.com
    port: 465
    user: ${SMTP_USER}         # QQ 邮箱账号
    password: ${SMTP_PASSWORD} # QQ 邮箱 SMTP 授权码
    sender-name: 出发啦         # 发件人显示名

# JWT 签名密钥
jwt:
  access-token-secret: ${JWT_ACCESS_TOKEN_SECRET}
  refresh-token-secret: ${JWT_REFRESH_TOKEN_SECRET}

# 业务签名密钥
sign:
  price-secret-key: ${PRICE_SIGN_SECRET_KEY}

# 高德地图（MCP 工具调用）
amap:
  api-key: ${AMAP_MAPS_API_KEY}
